{
  "name": "fractal-lab",
  "version": "1.0.0",
  "description": "Realtime fractal art playground powered by Astro and Three.js.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "deploy": "bun run build && npx wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "bun run build && npx wrangler deploy --dry-run --config dist/server/wrangler.json",
    "cf:status": "../scripts/cf-portfolio.sh status fractal-lab",
    "lint": "oxlint",
    "format": "oxfmt",
    "prepare": "husky",
    "lint:fix": "oxlint --fix . && oxfmt"
  },
  "dependencies": {
    "astro": "7.0.3",
    "three": "^0.185.0",
    "wrangler": "4.105.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/cloudflare": "14.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
